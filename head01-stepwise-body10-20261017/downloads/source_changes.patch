+"""Prediction-only fixed observation weights and local-pose preservation."""
+import json,os
+from pathlib import Path
+import torch
+from egosmplx_pipeline.body_common import axis_angle_rotation
+
+ARM_NAMES={'L_Shoulder','R_Shoulder','L_Elbow','R_Elbow','L_Wrist','R_Wrist'}
+
+def observation_weights(names,t):
+    quality=json.loads(Path(os.environ['EGOSMPLX_RELIABILITY_JSON']).read_text())
+    return t([quality['points'].get(name,{}).get('weight',0.) for name in names])
+
+def canonical(joints,global_axis):
+    return (joints[:25]-joints[:1]) @ axis_angle_rotation(global_axis.reshape(3))
+
+def keep_loss(joints,global_axis,reference):
+    return .005*((canonical(joints,global_axis)-reference)/.05).square().mean()

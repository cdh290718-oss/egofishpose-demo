@@ -0,0 +1,28 @@
+import unittest
+import torch
+import torch.nn.functional as F
+from egosmplx_pipeline.body_pose import confidence_weighted_reprojection
+
+class ConfidenceWeightTests(unittest.TestCase):
+    def test_equal_weights_preserve_original_loss_and_gradient(self):
+        x=torch.tensor([[.2,.4],[4.,-8.],[30.,2.]],requires_grad=True)
+        target=torch.zeros_like(x);size=torch.tensor([1280.,720.])
+        old=F.smooth_l1_loss(x/size,target,beta=.003)
+        new=confidence_weighted_reprojection(x,target,size,torch.ones(3))
+        self.assertTrue(torch.allclose(old,new))
+        self.assertTrue(torch.allclose(torch.autograd.grad(old,x)[0],torch.autograd.grad(new,x)[0]))
+
+    def test_low_confidence_joint_has_less_influence(self):
+        x=torch.tensor([[10.,10.],[10.,10.]],requires_grad=True)
+        scores=torch.tensor([.3,.9]);weights=scores.square()
+        loss=confidence_weighted_reprojection(x,torch.zeros_like(x),torch.tensor([1280.,720.]),weights)
+        gradient=torch.autograd.grad(loss,x)[0]
+        self.assertTrue(torch.allclose(gradient[1],9*gradient[0]))
+
+    def test_weight_normalization_preserves_residual_prior_balance(self):
+        x=torch.tensor([[20.,10.],[2.,-1.]])
+        args=(x,torch.zeros_like(x),torch.tensor([1280.,720.]))
+        weights=torch.tensor([.2,.7])
+        self.assertTrue(torch.allclose(confidence_weighted_reprojection(*args,weights),confidence_weighted_reprojection(*args,weights*100)))
+
+if __name__=='__main__':unittest.main()

+def confidence_weighted_reprojection(pixels, target, image_size, weights):
+    """Keep the original coordinate normalization and robust scale; weight joints."""
+    residual = (pixels - target) / image_size
+    per_joint = F.smooth_l1_loss(residual, torch.zeros_like(target), beta=.003, reduction='none').mean(dim=1)
+    return (per_joint * weights).sum() / weights.sum()
+
